 <!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ग्राम ऑर्गेनिक - गांव के शुद्ध उत्पाद</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f5f5f5; }
        header { background-color: #4CAF50; color: white; padding: 20px; text-align: center; }
        nav { background-color: #333; padding: 10px; text-align: center; }
        nav a { color: white; margin: 0 15px; text-decoration: none; }
        .container { padding: 20px; }
        .product, .checkout { background: white; padding: 15px; margin: 15px 0; border-radius: 5px; box-shadow: 0 0 5px rgba(0,0,0,0.1); }
        .product img { max-width: 100%; height: auto; }
        .product h3 { margin-top: 10px; }
        .product button, .checkout button { background-color: #4CAF50; color: white; border: none; padding: 10px; cursor: pointer; border-radius: 4px; }
        .product button:hover, .checkout button:hover { background-color: #45a049; }
        footer { background-color: #333; color: white; text-align: center; padding: 10px; margin-top: 20px; }
        .cart { position: fixed; top: 10px; right: 10px; background: white; padding: 10px; border-radius: 5px; box-shadow: 0 0 5px rgba(0,0,0,0.2); }
    </style>
</head>
<body>
    <header>
        <h1>ग्राम ऑर्गेनिक</h1>
        <p>गांव से सीधे आपके घर तक शुद्धता</p>
    </header>

    <nav>
        <a href="#home">होम</a>
        <a href="#products">उत्पाद</a>
        <a href="#contact">संपर्क</a>
    </nav>

    <div class="cart">
        🛒 <span id="cart-count">0</span> आइटम्स | ₹<span id="cart-total">0</span>
        <button onclick="showCheckout()">Checkout</button>
    </div>

    <div class="container">
        <section id="home">
            <h2>हमारी कहानी</h2>
            <p>हम गांवों से ताजा और शुद्ध उत्पाद आपके घर तक लाते हैं। हमारे उत्पाद 100% प्राकृतिक और रसायन-मुक्त होते हैं।</p>
        </section>

        <section id="products">
            <h2>हमारे उत्पाद</h2>
            <div class="product" data-price="350">
                <img src="https://via.placeholder.com/300x200" alt="शुद्ध शहद">
                <h3>शुद्ध शहद</h3>
                <p>₹350/500 ग्राम</p>
                <button onclick="addToCart('शुद्ध शहद', 350)">कार्ट में जोड़ें</button>
            </div>
            <div class="product" data-price="900">
                <img src="https://via.placeholder.com/300x200" alt="देसी घी">
                <h3>देसी घी</h3>
                <p>₹900/1 किलो</p>
                <button onclick="addToCart('देसी घी', 900)">कार्ट में जोड़ें</button>
            </div>
            <div class="product" data-price="150">
                <img src="https://via.placeholder.com/300x200" alt="ऑर्गेनिक मसाले">
                <h3>ऑर्गेनिक मसाले</h3>
                <p>₹150/100 ग्राम</p>
                <button onclick="addToCart('ऑर्गेनिक मसाले', 150)">कार्ट में जोड़ें</button>
            </div>
        </section>

        <section id="checkout" style="display:none;" class="checkout">
            <h2>Checkout</h2>
            <ul id="checkout-list"></ul>
            <p>कुल राशि: ₹<span id="checkout-total">0</span></p>
            <button onclick="simulatePayment()">पेमेंट करें</button>
        </section>

        <section id="contact">
            <h2>संपर्क करें</h2>
            <p>Email: info@gramorganic.in</p>
            <p>फोन: +91-9000000000</p>
        </section>
    </div>

    <footer>
        &copy; 2025 ग्राम ऑर्गेनिक | सभी अधिकार सुरक्षित
    </footer>

    <script>
        let cart = [];

        function addToCart(name, price) {
            cart.push({ name, price });
            updateCartDisplay();
            alert(name + ' कार्ट में जोड़ा गया!');
        }

        function updateCartDisplay() {
            document.getElementById('cart-count').innerText = cart.length;
            let total = cart.reduce((sum, item) => sum + item.price, 0);
            document.getElementById('cart-total').innerText = total;
        }

        function showCheckout() {
            let checkoutSection = document.getElementById('checkout');
            let checkoutList = document.getElementById('checkout-list');
            let checkoutTotal = document.getElementById('checkout-total');

            checkoutList.innerHTML = '';
            let total = 0;
            cart.forEach(item => {
                let li = document.createElement('li');
                li.textContent = item.name + ' - ₹' + item.price;
                checkoutList.appendChild(li);
                total += item.price;
            });
            checkoutTotal.innerText = total;
            checkoutSection.style.display = 'block';
        }

        function simulatePayment() {
            if (cart.length === 0) {
                alert('कार्ट खाली है!');
                return;
            }
            alert('पेमेंट सफल! आपका ऑर्डर कन्फर्म हो गया है। धन्यवाद!');
            cart = [];
            updateCartDisplay();
            document.getElementById('checkout').style.display = 'none';
        }
    </script>
</body>
</html>
